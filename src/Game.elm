-- Dragon Strike — shiny blue dragon with white lightning.
-- Embedded SVG head, body, bends, and tail follow each segment direction.
-- Wrap-around movement, variable prey, increasing speed, and R to restart.


module Game exposing
    ( Direction(..)
    , DragonPart(..)
    , FoodType(..)
    , GameStatus(..)
    , Model
    , Msg(..)
    , Position
    , Segment
    , allFoodTypes
    , bodySegments
    , cornerColors
    , cornerRotation
    , differentFood
    , directionToward
    , dragonSegments
    , foodIcon
    , foodName
    , gridSize
    , initialModel
    , main
    , nextHead
    , tickGame
    , update
    )

import Browser
import Browser.Events exposing (onKeyDown)
import Html exposing (Html, div, h1, node, p, text)
import Html.Attributes exposing (class, style)
import Json.Decode as Decode
import Random
import Svg exposing (Svg, rect, svg)
import Svg.Attributes as SA
import Task
import Time


cellSize : Int
cellSize =
    20


gridSize : Int
gridSize =
    20


type Direction
    = Up
    | Down
    | Left
    | Right


type GameStatus
    = Playing
    | GameOver


type FoodType
    = Mouse
    | Vole
    | Rat
    | Rabbit
    | Squirrel
    | Duck
    | Quail
    | Snake
    | Lizard
    | Frog


type alias Position =
    { x : Int, y : Int }


type DragonPart
    = DragonHead
    | DragonBody
    | DragonBend Direction
    | DragonTail


type alias Segment =
    { part : DragonPart
    , direction : Direction
    , position : Position
    }


type alias Model =
    { head : Position
    , body : List Position
    , direction : Direction
    , food : Position
    , foodType : FoodType
    , randomSeed : Random.Seed
    , score : Int
    , highScore : Int
    , status : GameStatus
    }


initialModel : Model
initialModel =
    { head = { x = 10, y = 10 }
    , body = [ { x = 9, y = 10 }, { x = 8, y = 10 } ]
    , direction = Right
    , food = { x = 5, y = 5 }
    , foodType = Mouse
    , randomSeed = Random.initialSeed 0
    , score = 0
    , highScore = 0
    , status = Playing
    }


type Msg
    = Tick Time.Posix
    | KeyPressed Direction
    | Restart
    | InitializeFood Time.Posix
    | Ignore



-- GAME LOGIC --


nextHead : Direction -> Position -> Position
nextHead dir pos =
    case dir of
        Up ->
            { pos | y = modBy gridSize (pos.y - 1) }

        Down ->
            { pos | y = modBy gridSize (pos.y + 1) }

        Left ->
            { pos | x = modBy gridSize (pos.x - 1) }

        Right ->
            { pos | x = modBy gridSize (pos.x + 1) }


hitsItself : Position -> List Position -> Bool
hitsItself head body =
    List.member head body


respawnFood : Position -> Position
respawnFood current =
    { x = modBy gridSize (current.x * 7 + 3)
    , y = modBy gridSize (current.y * 13 + 7)
    }


allFoodTypes : List FoodType
allFoodTypes =
    [ Mouse, Vole, Rat, Rabbit, Squirrel, Duck, Quail, Snake, Lizard, Frog ]


foodName : FoodType -> String
foodName foodType =
    case foodType of
        Mouse ->
            "Mouse"

        Vole ->
            "Vole"

        Rat ->
            "Rat"

        Rabbit ->
            "Rabbit"

        Squirrel ->
            "Squirrel"

        Duck ->
            "Duck"

        Quail ->
            "Quail"

        Snake ->
            "Snake"

        Lizard ->
            "Lizard"

        Frog ->
            "Frog"


differentFood : FoodType -> Random.Generator FoodType
differentFood current =
    case List.filter ((/=) current) allFoodTypes of
        first :: rest ->
            Random.uniform first rest

        [] ->
            -- Unreachable with our ten-type catalogue; Random.uniform needs a first choice.
            Random.constant Mouse


isOpposite : Direction -> Direction -> Bool
isOpposite a b =
    case ( a, b ) of
        ( Up, Down ) ->
            True

        ( Down, Up ) ->
            True

        ( Left, Right ) ->
            True

        ( Right, Left ) ->
            True

        _ ->
            False


tickGame : Model -> Model
tickGame model =
    case model.status of
        GameOver ->
            model

        Playing ->
            let
                newHead =
                    nextHead model.direction model.head

                ateFood =
                    newHead == model.food

                newBody =
                    if ateFood then
                        model.head :: model.body

                    else
                        model.head :: List.take (List.length model.body - 1) model.body

                newFood =
                    if ateFood then
                        respawnFood model.food

                    else
                        model.food

                ( newFoodType, newSeed ) =
                    if ateFood then
                        Random.step (differentFood model.foodType) model.randomSeed

                    else
                        ( model.foodType, model.randomSeed )

                newScore =
                    if ateFood then
                        model.score + 1

                    else
                        model.score

                newStatus =
                    if hitsItself newHead model.body then
                        GameOver

                    else
                        Playing
            in
            { model
                | head = newHead
                , body = newBody
                , food = newFood
                , foodType = newFoodType
                , randomSeed = newSeed
                , score = newScore
                , highScore = max model.highScore newScore
                , status = newStatus
            }



-- UPDATE --


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Tick _ ->
            ( tickGame model, Cmd.none )

        KeyPressed dir ->
            if isOpposite model.direction dir then
                ( model, Cmd.none )

            else
                ( { model | direction = dir }, Cmd.none )

        Restart ->
            let
                ( newFoodType, newSeed ) =
                    Random.step (differentFood model.foodType) model.randomSeed
            in
            ( { initialModel
                | highScore = model.highScore
                , foodType = newFoodType
                , randomSeed = newSeed
              }
            , Cmd.none
            )

        InitializeFood now ->
            let
                ( newFoodType, newSeed ) =
                    Random.step
                        (Random.uniform Mouse (List.drop 1 allFoodTypes))
                        (Random.initialSeed (Time.posixToMillis now))
            in
            ( { model | foodType = newFoodType, randomSeed = newSeed }, Cmd.none )

        Ignore ->
            ( model, Cmd.none )



-- VIEW --


foodIcon : FoodType -> String
foodIcon foodType =
    case foodType of
        Mouse ->
            "data:image/svg+xml;base64,"

        Vole ->
            "data:image/svg+xml;base64,"

        Rat ->
            "data:image/svg+xml;base64,"

        Rabbit ->
            "data:image/svg+xml;base64,"

        Squirrel ->
            "data:image/svg+xml;base64,"

        Duck ->
            "data:image/svg+xml;base64,"

        Quail ->
            "data:image/svg+xml;base64,"

        Snake ->
            "data:image/svg+xml;base64,"

        Lizard ->
            "data:image/svg+xml;base64,"

        Frog ->
            "data:image/svg+xml;base64,"


headIcon : String
headIcon =
    "data:image/svg+xml;base64,"


bodyIcon : String
bodyIcon =
    "data:image/svg+xml;base64,"


tailIcon : String
tailIcon =
    "data:image/svg+xml;base64,"


bendIcon : String
bendIcon =
    "data:image/svg+xml;base64,"


reversedBendIcon : String
reversedBendIcon =
    "data:image/svg+xml;base64,"


drawCell : String -> Position -> Svg msg
drawCell color pos =
    rect
        [ SA.x (String.fromInt (pos.x * cellSize))
        , SA.y (String.fromInt (pos.y * cellSize))
        , SA.width (String.fromInt cellSize)
        , SA.height (String.fromInt cellSize)
        , SA.fill color
        , SA.rx "3"
        ]
        []


directionToward : Position -> Position -> Direction
directionToward pos ahead =
    if nextHead Right pos == ahead then
        Right

    else if nextHead Left pos == ahead then
        Left

    else if nextHead Up pos == ahead then
        Up

    else
        Down


bodySegments : Position -> List Position -> List Segment
bodySegments ahead positions =
    case positions of
        [] ->
            []

        pos :: rest ->
            { part =
                case rest of
                    [] ->
                        DragonTail

                    behind :: _ ->
                        if isOpposite (directionToward pos ahead) (directionToward pos behind) then
                            DragonBody

                        else
                            DragonBend (directionToward pos behind)
            , direction = directionToward pos ahead
            , position = pos
            }
                :: bodySegments pos rest


dragonSegments : Model -> List Segment
dragonSegments model =
    { part = DragonHead, direction = model.direction, position = model.head }
        :: bodySegments model.head model.body



-- The base bend joins Left and Up. Both traversal orders use the same shape.


cornerRotation : Direction -> Direction -> Int
cornerRotation ahead behind =
    if List.member Left [ ahead, behind ] && List.member Up [ ahead, behind ] then
        0

    else if List.member Up [ ahead, behind ] && List.member Right [ ahead, behind ] then
        90

    else if List.member Right [ ahead, behind ] && List.member Down [ ahead, behind ] then
        180

    else
        270


oppositeDirection : Direction -> Direction
oppositeDirection direction =
    case direction of
        Up ->
            Down

        Down ->
            Up

        Left ->
            Right

        Right ->
            Left



-- Horizontal sprites stay upright when mirrored, so their dorsal shading stays on top.


spineSide : Direction -> Direction
spineSide direction =
    case direction of
        Up ->
            Left

        Down ->
            Right

        _ ->
            Up



-- Whether the dorsal shading belongs inside at the base tile's Left and Up endpoints.


cornerColors : Direction -> Direction -> ( Bool, Bool )
cornerColors ahead behind =
    let
        ( ( leftEdge, leftInside ), ( topEdge, topInside ) ) =
            case cornerRotation ahead behind of
                0 ->
                    ( ( Left, Up ), ( Up, Left ) )

                90 ->
                    ( ( Up, Right ), ( Right, Up ) )

                180 ->
                    ( ( Right, Down ), ( Down, Right ) )

                _ ->
                    ( ( Down, Left ), ( Left, Down ) )

        matchesInside edge inside =
            spineSide
                (if edge == ahead then
                    ahead

                 else
                    oppositeDirection behind
                )
                == inside
    in
    ( matchesInside leftEdge leftInside, matchesInside topEdge topInside )


drawDragonImage : String -> List (Svg.Attribute msg) -> Svg msg
drawDragonImage icon attributes =
    Svg.image
        ([ SA.xlinkHref icon
         , SA.x (String.fromInt (negate cellSize // 2))
         , SA.y (String.fromInt (negate cellSize // 2))
         , SA.width (String.fromInt cellSize)
         , SA.height (String.fromInt cellSize)
         ]
            ++ attributes
        )
        []


drawBend : Segment -> Direction -> Svg msg
drawBend segment behind =
    let
        ( leftInside, topInside ) =
            cornerColors segment.direction behind

        baseIcon =
            if leftInside then
                bendIcon

            else
                reversedBendIcon

        topIcon =
            if topInside then
                bendIcon

            else
                reversedBendIcon

        maskId =
            "bend-mask-" ++ String.fromInt segment.position.x ++ "-" ++ String.fromInt segment.position.y

        gradientId =
            maskId ++ "-gradient"

        low =
            String.fromFloat (toFloat cellSize * -0.5)

        edge =
            String.fromFloat (toFloat cellSize * -0.22)

        size =
            String.fromInt cellSize
    in
    if leftInside == topInside then
        drawDragonImage baseIcon []

    else
        Svg.g []
            [ Svg.defs []
                [ Svg.linearGradient
                    [ SA.id gradientId
                    , SA.gradientUnits "userSpaceOnUse"
                    , SA.x1 low
                    , SA.y1 edge
                    , SA.x2 edge
                    , SA.y2 low
                    ]
                    [ Svg.stop [ SA.offset "0", SA.stopColor "black" ] []
                    , Svg.stop [ SA.offset "1", SA.stopColor "white" ] []
                    ]
                , Svg.mask
                    [ SA.id maskId
                    , SA.maskUnits "userSpaceOnUse"
                    , SA.maskContentUnits "userSpaceOnUse"
                    , SA.x low
                    , SA.y low
                    , SA.width size
                    , SA.height size
                    ]
                    [ rect
                        [ SA.x low
                        , SA.y low
                        , SA.width size
                        , SA.height size
                        , SA.fill ("url(#" ++ gradientId ++ ")")
                        ]
                        []
                    ]
                ]
            , drawDragonImage baseIcon []
            , drawDragonImage topIcon [ SA.mask ("url(#" ++ maskId ++ ")") ]
            ]


drawDragonSegment : Segment -> Svg msg
drawDragonSegment segment =
    let
        px =
            segment.position.x * cellSize

        py =
            segment.position.y * cellSize

        artwork =
            case segment.part of
                DragonHead ->
                    drawDragonImage headIcon []

                DragonBody ->
                    drawDragonImage bodyIcon []

                DragonBend behind ->
                    drawBend segment behind

                DragonTail ->
                    drawDragonImage tailIcon []

        orientation =
            case segment.part of
                DragonBend behind ->
                    "rotate(" ++ String.fromInt (cornerRotation segment.direction behind) ++ ")"

                _ ->
                    case segment.direction of
                        Right ->
                            "scale(1 1)"

                        Left ->
                            "scale(-1 1)"

                        Up ->
                            "rotate(-90)"

                        Down ->
                            "rotate(90)"
    in
    Svg.g
        [ SA.transform
            ("translate("
                ++ String.fromInt (px + cellSize // 2)
                ++ " "
                ++ String.fromInt (py + cellSize // 2)
                ++ ") "
                ++ orientation
            )
        ]
        [ artwork ]


drawFood : FoodType -> Position -> Svg msg
drawFood foodType pos =
    Svg.image
        [ SA.xlinkHref (foodIcon foodType)
        , SA.x (String.fromInt (pos.x * cellSize))
        , SA.y (String.fromInt (pos.y * cellSize))
        , SA.width (String.fromInt cellSize)
        , SA.height (String.fromInt cellSize)
        ]
        [ Svg.title [] [ Svg.text (foodName foodType) ] ]


drawBoard : List (Svg msg)
drawBoard =
    List.concatMap
        (\row ->
            List.map
                (\col -> drawCell "#0a1628" { x = col, y = row })
                (List.range 0 (gridSize - 1))
        )
        (List.range 0 (gridSize - 1))


skyCss : String
skyCss =
    """
body { margin: 0; }

.sky {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    box-sizing: border-box;
    padding: 24px;
    background: #071225;
    display: grid;
    place-items: center;
}

.cloud {
    position: absolute;
    left: 0;
    width: 240px;
    height: 90px;
    fill: #dbeafe;
    opacity: 0.06;
    pointer-events: none;
    animation: drift 90s linear infinite;
}

.cloud-one { top: 12%; animation-delay: -30s; }
.cloud-two { top: 70%; animation-duration: 110s; animation-delay: -80s; }

.sky-game { position: relative; }

@keyframes drift {
    from { transform: translateX(-260px); }
    to   { transform: translateX(100vw); }
}

@media (prefers-reduced-motion: reduce) {
    .cloud { animation: none; left: 8%; }
    .cloud-two { left: 60%; }
}
"""


cloud : String -> Html msg
cloud name =
    Svg.svg
        [ SA.class ("cloud " ++ name)
        , SA.viewBox "0 0 240 90"
        , SA.width "240"
        , SA.height "90"
        , Html.Attributes.attribute "aria-hidden" "true"
        , Html.Attributes.attribute "focusable" "false"
        ]
        [ Svg.ellipse [ SA.cx "120", SA.cy "62", SA.rx "105", SA.ry "24" ] []
        , Svg.circle [ SA.cx "85", SA.cy "48", SA.r "28" ] []
        , Svg.circle [ SA.cx "140", SA.cy "38", SA.r "34" ] []
        ]


withSky : Html msg -> Html msg
withSky game =
    div [ class "sky" ]
        [ node "style" [] [ text skyCss ]
        , cloud "cloud-one"
        , cloud "cloud-two"
        , div [ class "sky-game" ] [ game ]
        ]


view : Model -> Html Msg
view model =
    withSky (viewGame model)


viewGame : Model -> Html Msg
viewGame model =
    let
        statusText =
            case model.status of
                GameOver ->
                    [ p
                        [ style "color" "#eab308"
                        , style "font-size" "22px"
                        , style "margin" "8px 0 2px 0"
                        , style "text-align" "center"
                        ]
                        [ text "GO DRAGONS!" ]
                    , p
                        [ style "color" "#94a3b8"
                        , style "font-size" "14px"
                        , style "margin" "0"
                        , style "text-align" "center"
                        ]
                        [ text "press R to play again" ]
                    ]

                Playing ->
                    []
    in
    div
        [ style "font-family" "monospace"
        , style "background" "#0a1628"
        , style "padding" "16px"
        , style "display" "inline-block"
        , style "border" "3px solid #1d4ed8"
        , style "border-radius" "10px"
        ]
        ([ h1
            [ style "color" "#16a34a"
            , style "margin" "0 0 8px 0"
            , style "font-size" "20px"
            , style "text-align" "center"
            , style "letter-spacing" "2px"
            ]
            [ text "DRAGON STRIKE" ]
         , div
            [ style "display" "flex"
            , style "justify-content" "space-between"
            , style "margin-bottom" "8px"
            ]
            [ p [ style "color" "#16a34a", style "margin" "0" ]
                [ text ("Prey caught: " ++ String.fromInt model.score) ]
            , p [ style "color" "#1d4ed8", style "margin" "0" ]
                [ text ("Best: " ++ String.fromInt model.highScore) ]
            ]
         , p [ style "color" "#e6cba0", style "margin" "0 0 8px 0" ]
            [ text ("Next prey: " ++ foodName model.foodType) ]
         , svg
            [ SA.width (String.fromInt (gridSize * cellSize))
            , SA.height (String.fromInt (gridSize * cellSize))
            ]
            (drawBoard
                ++ List.map drawDragonSegment (dragonSegments model)
                ++ [ drawFood model.foodType model.food ]
            )
         ]
            ++ statusText
        )



-- SUBSCRIPTIONS --


keyDecoder : Decode.Decoder Msg
keyDecoder =
    Decode.map toMsg (Decode.field "key" Decode.string)


toMsg : String -> Msg
toMsg key =
    case key of
        "ArrowUp" ->
            KeyPressed Up

        "ArrowDown" ->
            KeyPressed Down

        "ArrowLeft" ->
            KeyPressed Left

        "ArrowRight" ->
            KeyPressed Right

        "r" ->
            Restart

        "R" ->
            Restart

        _ ->
            Ignore


subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.batch
        [ Time.every (toFloat (max 80 (200 - model.score * 10))) Tick
        , onKeyDown keyDecoder
        ]


main : Program () Model Msg
main =
    Browser.element
        { init = \_ -> ( initialModel, Task.perform InitializeFood Time.now )
        , view = view
        , update = update
        , subscriptions = subscriptions
        }
